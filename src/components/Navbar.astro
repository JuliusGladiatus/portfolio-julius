---
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../utils/path';

const links = [
	{ href: withBase('/projets'), label: 'Projets' },
	{ href: withBase('/stills'), label: 'Stills' },
	{ href: withBase('/a-propos'), label: 'À propos' },
	{ href: withBase('/contact'), label: 'Contact' },
];
---

<header class="navbar">
	<div class="wrap inner">
		<a href={withBase('/')} class="brand">Julius Behind The Scenes</a>

		<div class="right">
			<nav class="links" id="nav-links" aria-label="Navigation principale">
				{links.map((link) => (
					<a href={link.href}>{link.label}</a>
				))}
			</nav>

			<ThemeToggle />

			<button class="menu-toggle" id="menu-toggle" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav-links">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</div>
</header>

<style>
	/* ── Barre fixe glass-clear ──────────────────────── */
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		height: var(--navbar-height);
		/* glass-clear via variables du thème */
		background: var(--glass-clear-bg);
		backdrop-filter: blur(10px) saturate(140%);
		-webkit-backdrop-filter: blur(10px) saturate(140%);
		border-bottom: 1px solid var(--glass-clear-border);
		transition: background 0.3s, border-color 0.3s;
	}

	@supports not (backdrop-filter: blur(1px)) {
		.navbar { background: var(--glass-clear-fallback); }
	}

	.inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 100%;
		padding: 0 28px;
	}

	/* ── Marque ─────────────────────────────────────── */
	.brand {
		font-family: var(--font-display);
		font-size: 20px;
		text-decoration: none;
		color: var(--color-text);
		white-space: nowrap;
		/* Détache le texte de l'image quelle que soit la photo derrière */
		text-shadow: 0 1px 8px rgba(8, 8, 6, 0.50);
	}

	:root[data-theme='light'] .brand {
		text-shadow: 0 1px 6px rgba(8, 8, 6, 0.15);
	}

	/* ── Droite (liens + boutons) ────────────────────── */
	.right {
		display: flex;
		align-items: center;
		gap: 18px;
	}

	/* ── Liens de navigation ─────────────────────────── */
	.links {
		display: none;
		align-items: center;
		gap: 22px;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 13.5px;
		letter-spacing: 0.03em;
	}

	.links a {
		position: relative;
		text-decoration: none;
		color: var(--color-text-muted);
		padding-bottom: 2px;
		transition: color 0.2s;
		text-shadow: 0 1px 6px rgba(8, 8, 6, 0.45);
	}

	:root[data-theme='light'] .links a {
		text-shadow: 0 1px 4px rgba(8, 8, 6, 0.12);
	}

	/* Soulignement animé au survol */
	.links a::after {
		content: '';
		position: absolute;
		bottom: -1px;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--color-text);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.25s cubic-bezier(0.25, 0, 0, 1);
	}

	.links a:hover,
	.links a:focus-visible {
		color: var(--color-text);
	}

	.links a:hover::after,
	.links a:focus-visible::after {
		transform: scaleX(1);
	}

	/* ── Bouton hamburger (mobile) ───────────────────── */
	.menu-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 8px;
		/* Pastille légère à l'intérieur de la navbar glass — pas de backdrop-filter imbriqué */
		border: 1px solid var(--glass-clear-border);
		background: rgba(248, 249, 255, 0.06);
		color: var(--color-text);
		cursor: pointer;
		transition: background 0.2s, border-color 0.2s;
	}

	:root[data-theme='light'] .menu-toggle {
		background: rgba(69, 68, 65, 0.06);
	}

	.menu-toggle:hover {
		background: rgba(248, 249, 255, 0.12);
		border-color: var(--glass-blur-border);
	}

	:root[data-theme='light'] .menu-toggle:hover {
		background: rgba(69, 68, 65, 0.10);
	}

	.menu-toggle svg {
		width: 18px;
		height: 18px;
	}

	/* ── Bureau : liens inline, hamburger masqué ─────── */
	@media (min-width: 760px) {
		.links      { display: flex; }
		.menu-toggle { display: none; }
	}

	/* ── Mobile : menu déroulant glass-blur ─────────── */
	@media (max-width: 759px) {
		.links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: flex-start;
			gap: 4px;
			padding: 12px 28px 20px;
			/* glass-blur pour le panneau déroulant */
			background: var(--glass-blur-bg);
			backdrop-filter: blur(20px) saturate(150%);
			-webkit-backdrop-filter: blur(20px) saturate(150%);
			border-bottom: 1px solid var(--glass-blur-border);
		}

		@supports not (backdrop-filter: blur(1px)) {
			.links { background: var(--glass-blur-fallback); }
		}

		.links.is-open {
			display: flex;
		}

		.links a {
			width: 100%;
			padding: 10px 0;
			border-bottom: none;
		}
	}
</style>

<script>
	const toggle = document.getElementById('menu-toggle');
	const links = document.getElementById('nav-links');

	toggle?.addEventListener('click', () => {
		const isOpen = links?.classList.toggle('is-open');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});
</script>
