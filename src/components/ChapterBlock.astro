---
import VideoEmbed from './VideoEmbed.astro';
import ShortFormCarousel from './ShortFormCarousel.astro';
import PhotoCarousel from './PhotoCarousel.astro';
import { withBase } from '../utils/path';

interface Photo {
  src: string;
  caption?: string;
}

interface Chapter {
  titre: string;
  video_plateforme?: 'youtube' | 'vimeo';
  video_id?: string;
  video_fichier?: string;
  video_thumbnail?: string;
  photos: Photo[];
  videos_verticales: { src: string; zoom: number }[];
  preview_time?: number;
}

interface Props {
  chapter: Chapter;
  isFirst: boolean;
  projectImage: string;
}

const { chapter, isFirst, projectImage } = Astro.props;

const hasEmbed   = !!(chapter.video_plateforme && chapter.video_id);
const hasFile    = !!chapter.video_fichier;
const hasGallery = chapter.photos.length > 0;
const hasCarousel = chapter.videos_verticales.length > 0;
---

{!isFirst && <hr class="chapter-sep" />}

<div class="chapter">
  <h3 class="chapter-title">{chapter.titre}</h3>

  {(hasFile || hasEmbed) && (
    <div class="chapter-video">
      {hasFile ? (
        <div class="file-wrap">
          <video controls preload="metadata" src={withBase(chapter.video_fichier!)}></video>
        </div>
      ) : (
        <VideoEmbed
          platform={chapter.video_plateforme}
          videoId={chapter.video_id}
          title={chapter.titre}
          facade={projectImage}
          thumbnail={chapter.video_thumbnail}
        />
      )}
    </div>
  )}

  {hasGallery && <PhotoCarousel photos={chapter.photos} />}

  {hasCarousel && (
    <ShortFormCarousel videos={chapter.videos_verticales} previewTime={chapter.preview_time} />
  )}
</div>

<style>
  .chapter-sep {
    border: none;
    border-top: 1px solid var(--color-surface-border);
    margin: 0 0 52px;
  }

  .chapter {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 52px;
  }

  .chapter:last-child {
    margin-bottom: 0;
  }

  .chapter-title {
    font-size: clamp(20px, 2.8vw, 26px);
    font-weight: 600;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .file-wrap {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #0a0a0a;
  }

  .file-wrap video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }
</style>
