---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/path';

const photos = [
  '/images/stills/still-01.jpg',
  '/images/stills/still-02.jpg',
  '/images/stills/still-03.jpg',
  '/images/stills/still-04.jpg',
  '/images/stills/still-05.jpg',
  '/images/stills/still-06.jpg',
  '/images/stills/still-07.jpg',
  '/images/stills/still-08.jpg',
  '/images/stills/still-09.jpg',
  '/images/stills/still-10.jpg',
  '/images/stills/still-11.jpg',
  '/images/stills/still-12.jpg',
  '/images/stills/still-13.jpg',
  '/images/stills/still-14.jpg',
  '/images/stills/still-15.jpg',
  '/images/stills/still-16.jpg',
  '/images/stills/still-17.jpg',
  '/images/stills/still-18.jpg',
  '/images/stills/still-19.jpg',
  '/images/stills/still-20.jpg',
].map(withBase);
---

<Layout title="Stills — Julius Behind The Scenes">
  <Navbar />

  <PageHeader
    image="/images/stills/still-10.jpg"
    imagePosition="center"
    eyebrow="stills"
    title="Galerie photo"
    subtitle="Une sélection d'images fixes, capturées entre deux prises."
  />

  <div class="wrap">
    <section class="gallery-section">
      <div class="masonry" id="gallery">
        {photos.map((src, i) => (
          <button
            class="item"
            type="button"
            data-index={i}
            data-src={src}
            aria-label={`Agrandir la photo ${i + 1}`}
          >
            <img
              src={src}
              alt=""
              loading={i < 9 ? 'eager' : 'lazy'}
              decoding={i < 9 ? 'sync' : 'async'}
            />
          </button>
        ))}
      </div>
    </section>
  </div>

  <Footer />

  <!-- Lightbox — doit rester DANS le Layout (dans <body>) -->
  <div class="lb" id="lb" aria-modal="true" role="dialog" aria-hidden="true">
    <button class="lb-close" id="lb-close" aria-label="Fermer">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 5L15 15M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <button class="lb-arr lb-prev" id="lb-prev" aria-label="Photo précédente">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M12.5 16L7.5 10L12.5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <img class="lb-img" id="lb-img" src="" alt="" />

    <button class="lb-arr lb-next" id="lb-next" aria-label="Photo suivante">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M7.5 4L12.5 10L7.5 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <span class="lb-count" id="lb-count"></span>
  </div>
</Layout>

<style>
  /* ── galerie ─────────────────────────────────────── */
  .gallery-section {
    padding-top: 28px;
  }

  /* ── mosaïque masonry CSS columns ───────────────── */
  .masonry {
    columns: 3;
    column-gap: 10px;
  }

  @media (max-width: 860px) {
    .masonry { columns: 2; }
  }

  @media (max-width: 480px) {
    .masonry { columns: 1; }
  }

  .item {
    display: block;
    width: 100%;
    break-inside: avoid;
    margin-bottom: 10px;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  .item img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    transition: transform 0.38s cubic-bezier(0.2, 0, 0, 1);
  }

  /* voile d'assombrissement au survol */
  .item::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0);
    transition: background 0.3s;
    pointer-events: none;
  }

  .item:hover img {
    transform: scale(1.025);
  }

  .item:hover::after {
    background: rgba(0, 0, 0, 0.18);
  }

  /* ── lightbox ────────────────────────────────────── */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 200;
    /*
     * Fond semi-transparent + flou intense : la page reste devinable derrière.
     * On abandonne l'opacité quasi-totale au profit d'un glass-blur sombre.
     */
    background: rgba(8, 8, 6, 0.70);
    backdrop-filter: blur(36px) saturate(120%);
    -webkit-backdrop-filter: blur(36px) saturate(120%);
    display: flex;
    align-items: center;
    justify-content: center;
    /* état fermé : invisible ET non-interactive */
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.24s;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .lb { background: rgba(8, 8, 6, 0.92); }
  }

  /* état ouvert : on rétablit les pointer-events via une classe */
  .lb.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .lb-img {
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 4px;
    display: block;
    user-select: none;
    transition: opacity 0.18s;
  }

  /* ── pastilles glass-clear — fond toujours sombre → valeurs fixes ── */
  .lb-close {
    position: absolute;
    top: 16px;
    right: 18px;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(20, 19, 17, 0.28);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    border: 1px solid rgba(248, 249, 255, 0.14);
    color: rgba(248, 249, 255, 0.72);
    cursor: pointer;
    padding: 0;
    line-height: 0;
    transition: background 0.18s, color 0.18s;
  }

  .lb-close:hover {
    background: rgba(20, 19, 17, 0.50);
    color: #f8f9ff;
  }

  .lb-arr {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(20, 19, 17, 0.28);
    backdrop-filter: blur(10px) saturate(140%);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    border: 1px solid rgba(248, 249, 255, 0.14);
    color: rgba(248, 249, 255, 0.72);
    cursor: pointer;
    line-height: 0;
    transition: background 0.18s, color 0.18s;
  }

  .lb-arr:hover {
    background: rgba(20, 19, 17, 0.50);
    color: #f8f9ff;
  }

  .lb-prev { left: 18px; }
  .lb-next { right: 18px; }

  .lb-count {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    font-weight: 300;
    letter-spacing: 0.1em;
    color: rgba(248, 249, 255, 0.35);
  }
</style>

<script>
  const items   = [...document.querySelectorAll<HTMLButtonElement>('#gallery .item')];
  const lb      = document.getElementById('lb')!;
  const lbImg   = document.getElementById('lb-img') as HTMLImageElement;
  const lbCount = document.getElementById('lb-count')!;
  const lbClose = document.getElementById('lb-close')!;
  const lbPrev  = document.getElementById('lb-prev')!;
  const lbNext  = document.getElementById('lb-next')!;

  const srcs = items.map(el => el.dataset.src || '');
  let cur = 0;

  function renderLb() {
    lbImg.style.opacity = '0';
    const img = new Image();
    img.onload = () => {
      lbImg.src = img.src;
      lbImg.style.opacity = '1';
    };
    img.src = srcs[cur];
    lbCount.textContent = `${cur + 1} / ${srcs.length}`;
  }

  function openLb(idx: number) {
    cur = idx;
    lb.classList.add('is-open');
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    renderLb();
  }

  function closeLb() {
    lb.classList.remove('is-open');
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function nav(dir: number) {
    cur = (cur + dir + srcs.length) % srcs.length;
    renderLb();
  }

  items.forEach((el, i) => el.addEventListener('click', () => openLb(i)));
  lbClose.addEventListener('click', closeLb);
  lbPrev.addEventListener('click', () => nav(-1));
  lbNext.addEventListener('click', () => nav(1));

  lb.addEventListener('click', (e) => {
    if (e.target === lb) closeLb();
  });

  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('is-open')) return;
    if (e.key === 'Escape')     closeLb();
    if (e.key === 'ArrowLeft')  nav(-1);
    if (e.key === 'ArrowRight') nav(1);
  });

  let touchX = 0;
  lb.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) nav(dx < 0 ? 1 : -1);
  });
</script>
