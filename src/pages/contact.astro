---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Button from '../components/Button.astro';
import Footer from '../components/Footer.astro';

const services = [
	{
		name: 'Films de voyage',
		description: "Carnets de voyage filmés, du repérage au montage final — pour raconter un lieu, un itinéraire ou une expérience.",
	},
	{
		name: 'Sport & action',
		description: "Captation d'effort et de mouvement en conditions réelles — outdoor, montagne, eau — au plus près de l'action.",
	},
	{
		name: 'Corporate',
		description: "Films et photos pour campagnes, lancements de produit ou contenus réseaux sociaux, dans une esthétique cinématique.",
	},
];
---

<Layout title="Contact — Julius Behind The Scenes">
	<Navbar />

	<div class="wrap">
		<section class="masthead">
			<div class="eyebrow">contact</div>
			<h2>Travaillons ensemble</h2>
			<p class="lead muted">
				Disponible pour des missions de tournage et de production photo, en France et à l'étranger.
			</p>
		</section>

		<section class="services">
			<div class="eyebrow">prestations</div>
			<div class="list">
				{services.map((service) => (
					<div class="service">
						<h3>{service.name}</h3>
						<p class="muted">{service.description}</p>
					</div>
				))}
			</div>
		</section>

		<section class="reach">
			<div class="eyebrow">me contacter</div>
			<h2>Une idée, un projet, une question ?</h2>
			<p class="muted">
				Le plus simple reste un message — par email ou sur Instagram. Je réponds en général sous
				quelques jours.
			</p>
			<div class="actions">
				<Button href="mailto:collartjulianpro@gmail.com" variant="solid">collartjulianpro@gmail.com</Button>
				<Button href="https://instagram.com/juliusbhndthescenes">@juliusbhndthescenes</Button>
			</div>
		</section>
	</div>

	<Footer />
</Layout>

<style>
	.masthead {
		padding-bottom: 32px;
	}

	.services {
		padding-top: 0;
	}

	.list {
		display: grid;
		gap: 24px;
		margin-top: 8px;
	}

	.service p {
		max-width: 62ch;
	}

	.reach .actions {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
		margin-top: 22px;
	}

	@media (min-width: 760px) {
		.list {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
